#!/usr/bin/env bash
# The plugin's entry point: finds the build and runs it.
#
# A few lines of shell rather than the binary itself, for two reasons. The
# binary is forty-four megabytes, almost all of it language grammars, and a
# repository that is cloned on every install cannot carry one per machine. And
# a build that does not match the machine has to say so: without this the shell
# reports an exec format error, which is indistinguishable from a corrupt file
# and tells the operator nothing about what to do.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
BUILT="$REPO/target/release/resweep"

if [ ! -f "$BUILT" ]; then
  printf 'resweep: not built yet. Run ./install.sh from %s\n' "$REPO" >&2
  printf 'resweep: it needs a Rust toolchain and nothing else; see https://rustup.rs\n' >&2
  exit 1
fi

if [ ! -x "$BUILT" ]; then
  printf 'resweep: %s is not executable. Re-run ./install.sh from %s\n' "$BUILT" "$REPO" >&2
  exit 1
fi

# Whether the build is for this machine. `file` is not always present, so a
# missing one means the check is skipped rather than the tool refusing to run.
if command -v file >/dev/null 2>&1; then
  BUILD_KIND="$(file -b "$BUILT" 2>/dev/null)"
  HOST_KIND="$(uname -s) $(uname -m)"
  MATCHES=1
  case "$(uname -s)" in
    Darwin) case "$BUILD_KIND" in *Mach-O*) ;; *) MATCHES=0 ;; esac ;;
    Linux)  case "$BUILD_KIND" in *ELF*) ;; *) MATCHES=0 ;; esac ;;
  esac
  case "$(uname -m)" in
    arm64|aarch64) case "$BUILD_KIND" in *arm64*|*aarch64*) ;; *x86_64*) MATCHES=0 ;; esac ;;
    x86_64)        case "$BUILD_KIND" in *x86_64*) ;; *arm64*|*aarch64*) MATCHES=0 ;; esac ;;
  esac
  if [ "$MATCHES" -eq 0 ]; then
    printf 'resweep: the build at %s is not for this machine.\n' "$BUILT" >&2
    printf 'resweep: this machine is %s; the build is %s\n' "$HOST_KIND" "$BUILD_KIND" >&2
    printf 'resweep: rebuild here with `cargo build -p resweep --release` in %s\n' "$REPO" >&2
    exit 1
  fi
fi

exec "$BUILT" "$@"
