#!/usr/bin/env bash
# Retired name. This tool is now called resweep, short for refactor sweep.
#
# Kept working rather than removed, because someone midway through an audit
# should not learn about a rename by having their tooling stop. Removal is a
# later, separate decision.
#
# The notice goes to standard error and never to standard output: callers read
# the payload, and a deprecation line in the middle of it would break exactly
# the people this exists to protect. The exit code is resweep's, not this
# script's, or every wrapper would read a refusal as a success.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NEW="$HERE/resweep"

if [ ! -x "$NEW" ]; then
  printf 'codesweep: this tool is now called resweep, and resweep is not next to this script.\n' >&2
  printf 'codesweep: the install looks incomplete. Re-run install.sh from the repository.\n' >&2
  exit 1
fi

printf 'codesweep: renamed to resweep. Run `resweep` instead; this name will go in a later release.\n' >&2
exec "$NEW" "$@"
